# Copy to .env locally; never commit real values.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# First-party Google OAuth (not Lovable oauth.lovable.app).
# Google Cloud Console → Web application:
# Authorized JS origins: https://uygulamamcebimde.online
# Authorized redirect URIs: https://uygulamamcebimde.online/auth
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Optional Cloudflare Turnstile server secret (when enabled at the edge).
TURNSTILE_SECRET_KEY=

# Comma-separated exact email addresses allowed for one-time founder bootstrap.
FOUNDER_BOOTSTRAP_EMAILS=

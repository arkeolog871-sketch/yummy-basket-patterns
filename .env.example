# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lovable — yapay zekâ GEÇİDİ ve E-POSTA gönderimi (OTP, işletme sipariş bildirimi).
# OpenAI'ye geçsen bile e-posta için bu anahtar gerekli.
LOVABLE_API_KEY=

# SEÇMELİ geçit: Supabase üzerindeki "openai-gateway" fonksiyonunun adresi.
# BOŞ BIRAKIN; yalnızca o fonksiyon gerçekten yayındaysa doldurun. Supabase
# proje kodu TAM 20 harftir — eksik kopyalanan kod canlıda her isteğe HTTP 530
# (Cloudflare 1016) döndürdü ve hem sohbeti hem sesi tümden durdurdu.
# Boşken yapay zekâ aşağıdaki OPENAI_API_KEY ile doğrudan OpenAI'ye gider.
AI_GATEWAY_URL=
# Geçit JWT istemiyorsa boş bırakın; istiyorsa o projenin jetonunu yazın.
AI_GATEWAY_TOKEN=

# Yapay zekânın ÇALIŞAN yolu: sohbet, ses ve görsel bu anahtarla üretilir.
# Yalnızca sunucuda okunur; tarayıcıya çıkmaz.
OPENAI_API_KEY=

# Lovable geçidi yedeği varsayılan KAPALI; yalnızca 'true' ise devreye girer.
AI_ALLOW_LOVABLE_FALLBACK=false

# Model ezme (isteğe bağlı). Maliyet için ucuz modele geçmek kod değişikliği
# gerektirmesin diye var. Örn. AI_CHAT_MODEL=gpt-5.6-luna
AI_CHAT_MODEL=gpt-5.6-luna
# Alternatif ad (AI_CHAT_MODEL yoksa kullanılır)
OPENAI_MODEL=gpt-5.6-luna
AI_TRANSCRIBE_MODEL=
AI_SPEECH_MODEL=
AI_IMAGE_MODEL=

# Google OAuth
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Web Push (kapalı sekme/uygulamada bildirim) — `npx web-push generate-vapid-keys` ile üretilir
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

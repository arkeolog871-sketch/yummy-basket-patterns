# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lovable — yapay zekâ GEÇİDİ ve E-POSTA gönderimi (OTP, işletme sipariş bildirimi).
# OpenAI'ye geçsen bile e-posta için bu anahtar gerekli.
LOVABLE_API_KEY=

# OpenAI — BİRİNCİL sağlayıcı. Yalnızca sunucuda okunur, tarayıcıya çıkmaz.
# Gerçek anahtarı bu dosyaya yazma; Project Settings → Secrets'a ekle.
OPENAI_API_KEY=

# Lovable geçidi yedeği varsayılan KAPALI; yalnızca 'true' ise devreye girer.
AI_ALLOW_LOVABLE_FALLBACK=false

# Model ezme (isteğe bağlı). Maliyet için ucuz modele geçmek kod değişikliği
# gerektirmesin diye var. Örn. AI_CHAT_MODEL=gpt-5.6-luna
AI_CHAT_MODEL=gpt-5.6-luna
AI_TRANSCRIBE_MODEL=
AI_SPEECH_MODEL=
AI_IMAGE_MODEL=

# Google OAuth
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Web Push (kapalı sekme/uygulamada bildirim) — `npx web-push generate-vapid-keys` ile üretilir
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

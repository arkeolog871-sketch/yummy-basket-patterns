# Copy to .env locally; never commit real values.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# First-party Google OAuth (not Lovable oauth.lovable.app).
# Google Cloud Console → Web application:
# Authorized JS origins: https://uygulamamcebimde.online
# Authorized redirect URIs: https://uygulamamcebimde.online/auth
VITE_GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Server-only Lovable email API. Required to send the 6-digit OTP. Never prefix with VITE_.
LOVABLE_API_KEY=
LOVABLE_SEND_URL=

# Optional Cloudflare Turnstile server secret (when enabled at the edge).
TURNSTILE_SECRET_KEY=

# Staging-only (never the production project). Leave empty in production.
# STAGING_APP_URL must not be https://uygulamamcebimde.online
STAGING_APP_URL=
STAGING_DATABASE_URL=
STAGING_SUPABASE_DB_URL=
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
STAGING_OTP_CODE=
STAGING_MAILBOX_IMAP_HOST=
STAGING_MAILBOX_IMAP_PORT=993
STAGING_MAILBOX_USER=
STAGING_MAILBOX_PASSWORD=

# Operator-only production SQL apply (orders + notifications). Never commit values.
# Scripts refuse unless ALLOW_PRODUCTION_ORDER_MIGRATION=YES and the URL
# contains the production project ref (wxkyhwkcuiqxxxpawcid). Does not disable RLS.
# Used by: scripts/production-apply-*.mjs, npm run notification:prod-migrate
# ALLOW_PRODUCTION_ORDER_MIGRATION=
# PRODUCTION_DATABASE_URL=

# Comma-separated exact email addresses allowed for one-time founder bootstrap.
FOUNDER_BOOTSTRAP_EMAILS=

# Firebase Cloud Messaging HTTP v1 (server-only). Never prefix with VITE_.
# Used by: src/lib/notifications.server.ts (getFcmAccessToken / sendFcmMessage)
# Probe: npm run notification:fcm-probe
# Preflight: npm run notification:preflight [-- --strict]
# FIREBASE_PROJECT_ID defaults to silvan-cebimde when unset.
FIREBASE_PROJECT_ID=silvan-cebimde
# Service account client_email from Firebase Console → Project settings → Service accounts
FIREBASE_CLIENT_EMAIL=
# PEM private key; keep \n escaped as \\n in single-line env stores (Lovable/Cloudflare)
FIREBASE_PRIVATE_KEY=
# Android client config is NOT an env var: place real google-services.json at
# android-wrapper/app/google-services.json (gitignored). See android-wrapper/README.md.

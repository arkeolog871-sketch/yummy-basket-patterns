default_platform(:ios)

platform :ios do
  desc "Build a signed release archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false,
      in_house: false,
    )

    # CI run number always increases, so it's a safe, unique build number
    # for every TestFlight upload without hand-bumping CURRENT_PROJECT_VERSION.
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER"),
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "YP8PRJ4Q6M",
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end

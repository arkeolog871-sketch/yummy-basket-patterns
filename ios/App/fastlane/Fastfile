default_platform(:ios)

platform :ios do
  desc "Build a signed release archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      in_house: false,
    )

    # CI run number always increases, so it's a safe, unique build number
    # for every TestFlight upload without hand-bumping CURRENT_PROJECT_VERSION.
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER"),
    )

    # build_app doesn't forward the API key from app_store_connect_api_key's
    # lane context into the raw xcodebuild invocations on its own — without
    # this, xcodebuild falls back to looking for an Xcode-signed-in Apple ID
    # ("No Accounts") instead of using the API key. (The action's return hash
    # has no :key_filepath entry — read the file path from the env var we
    # wrote it to.) gym applies xcargs to both the archive and export
    # xcodebuild calls already — passing the same flags again via
    # export_xcargs duplicates them and xcodebuild rejects the command
    # ("option '-authenticationKeyPath' may only be provided once").
    auth_xcargs = "-allowProvisioningUpdates " \
                  "-authenticationKeyPath \"#{ENV.fetch('APP_STORE_CONNECT_API_KEY_PATH')}\" " \
                  "-authenticationKeyID \"#{api_key[:key_id]}\" " \
                  "-authenticationKeyIssuerID \"#{api_key[:issuer_id]}\""

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      # Without this, xcodebuild's automatic signing asked Apple for an
      # "iOS App Development" profile (which needs a registered test
      # device) instead of an App Store distribution profile.
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "YP8PRJ4Q6M",
      },
      xcargs: auth_xcargs,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end

default_platform(:ios)

platform :ios do
  desc "Build a signed release archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      in_house: false,
    )

    # CI run number always increases, so it's a safe, unique build number
    # for every TestFlight upload without hand-bumping CURRENT_PROJECT_VERSION.
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER"),
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "YP8PRJ4Q6M",
      },
      # build_app doesn't forward the API key from app_store_connect_api_key's
      # lane context into the raw `xcodebuild ... -allowProvisioningUpdates`
      # invocation on its own — without these it falls back to looking for an
      # Xcode-signed-in Apple ID ("No Accounts" error) instead of the API key.
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath \"#{api_key[:key_filepath]}\" " \
              "-authenticationKeyID \"#{api_key[:key_id]}\" " \
              "-authenticationKeyIssuerID \"#{api_key[:issuer_id]}\"",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end

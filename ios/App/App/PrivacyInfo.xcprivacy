<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Uygulamanın kendi gizlilik bildirimi. Çerçeveler (Capacitor, Firebase,
	  GoogleSignIn) kendi bildirimlerini ayrıca gönderiyor; bu dosya yalnızca
	  uygulama hedefinin kendi kodunu anlatır.

	  Uygulama hedefindeki Swift kodu (AppDelegate, SceneDelegate,
	  SilvanAuthPlugin, SilvanPushPlugin) Apple'ın gerekçe istediği API'lerden
	  yalnızca UserDefaults kullanıyor: SilvanPushPlugin, bildirim token'ını
	  kalıcı saklamak için (3B52.1 — yalnızca uygulamanın kendi içinde
	  erişilebilir bilgi okuma/yazma, başka bir uygulama/grupla paylaşılmıyor).
	  Dosya zaman damgası, disk alanı, sistem açılış süresi, etkin klavye
	  listesi kullanılmıyor.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>3B52.1</string>
			</array>
		</dict>
	</array>
	<!-- Uygulama reklam veya ölçüm amacıyla kullanıcı takibi yapmıyor. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  Toplanan veri türleri App Store Connect'teki gizlilik formunda beyan
	  ediliyor; asıl kaynak orası. Burada ikinci bir liste tutmak, iki beyanın
	  zamanla birbirinden ayrılması riskini getirirdi.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>

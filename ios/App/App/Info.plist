<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Silvan Cebimde</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Google girişi uygulama içinde tamamlanır (bkz. SilvanAuthPlugin).
	     GIDClientID: bu uygulamanın iOS OAuth istemcisi.
	     GIDServerClientID: Supabase'in doğruladığı Web istemcisi; Android
	     tarafı da aynı Web kimliğini kullanıyor. -->
	<key>GIDClientID</key>
	<string>690305033747-8f8nb3epkb00i45p7h3fh8hu74ibt415.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>690305033747-s0q65dae6feqfpndvrcmlmoictvehp99.apps.googleusercontent.com</string>
	<!-- GoogleSignIn oturumu bu şema ile uygulamaya döner. Değer, iOS
	     istemci kimliğinin ters çevrilmiş hâlidir; başka bir şey yazılamaz. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.690305033747-8f8nb3epkb00i45p7h3fh8hu74ibt415</string>
			</array>
		</dict>
	</array>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Uygulamanın teması cihazın karanlık moduna değil, site ayarına bağlı;
	     ekran her zaman krem. iOS ise durum çubuğu rengini cihazın moduna göre
	     seçiyordu: karanlık moddaki bir telefonda saat ve pil BEYAZ çiziliyor,
	     krem başlığın üstünde okunmuyordu. Ayrıca açılış ekranının sistem
	     zemini karanlık modda siyah oluyordu. Arayüz stilini sabitlemek
	     ikisini birden çözüyor; Apple giriş sayfası, uyarılar ve paylaşım
	     sayfası gibi sistem ekranları da uygulamayla aynı tonda kalıyor. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<!-- Niyet açıkça yazılsın: koyu içerik, yani açık zemin üzerinde okunur. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
	<key>NSCameraUsageDescription</key>
	<string>Yemek fotoğrafı ve fiş yüklemek için kamera erişimi gerekir.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Adresinizi haritada göstermek ve teslimat konumunu almak için konum izni gerekir.</string>
	<!-- Dosya seçicide "Fotoğraf Seç" yolu modern seçiciyi kullandığı için izin
	     istemiyor; ama izin isteyen herhangi bir yol bu metin olmadan
	     uygulamayı ANINDA çökertir ve inceleme sırasındaki bir çökme kesin
	     rettir. Metnin bedeli yok, yokluğunun bedeli büyük. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>İşletme ve ürün görseli yüklemek için fotoğraflarınıza erişim gerekir.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Video kaydı için mikrofon erişimi gerekir.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
